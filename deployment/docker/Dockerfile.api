# ── Stage 1: Build dependencies ───────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /app

# Install build tools
RUN apt-get update && apt-get install -y \
    build-essential gcc libffi-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# ── Stage 2: Runtime image ────────────────────────────────────────────
FROM python:3.11-slim AS runtime

WORKDIR /app

# curl needed by HEALTHCHECK
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Copy only the installed packages from builder
COPY --from=builder /install /usr/local

# Copy application source and migrations
COPY src/ ./src/
COPY alembic/ ./alembic/
COPY alembic.ini ./alembic.ini
COPY .env.example .env.example

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash documind
RUN mkdir -p /app/logs /app/data /app/vector_store && \
    chown -R documind:documind /app
USER documind

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run migrations then start the server.
# PORT is injected by Koyeb / Cloud Run / Render — defaults to 8000.
# Single worker keeps RSS well within the 512 MB free-tier ceiling.
CMD ["sh", "-c", "alembic upgrade head && uvicorn src.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --no-reload"]
